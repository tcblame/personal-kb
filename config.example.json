{
  "storage": {
    "root": "${PERSONAL_KB_ROOT}",
    "status": "example-public-config",
    "env_override": "PERSONAL_KB_ROOT",
    "records": "records",
    "retained_files": "retained-files",
    "manifests": "manifests",
    "runtime": "runtime",
    "cache": "cache"
  },
  "runtime": {
    "mode": "normal"
  },
  "challenge": {
    "success_sample_rate": 0.1,
    "max_adopted_entries": 3,
    "critique_depth": 1,
    "defer_success_samples": true,
    "risk_terms": [
      "生产事故",
      "回滚",
      "数据丢失",
      "安全",
      "证据冲突",
      "用户否定",
      "production incident",
      "rollback",
      "security"
    ]
  },
  "cleanup": {
    "auto_merge_mode": "ai",
    "exact_duplicate_threshold": 0.95,
    "same_issue_strategy": {
      "mode": "ai",
      "same_day_merge": true,
      "time_span_hours": 2,
      "title_similarity": 0.85,
      "complementary_types": true
    },
    "fix_superseded_state": true,
    "log_level": "info"
  },
  "search": {
    "expand_queries": true,
    "expand_ip_addresses": true,
    "expand_abbreviations": true,
    "include_archived_on_empty": true
  },
  "usage": {
    "heat_field": "used_count",
    "heat_field_role": "legacy_baseline",
    "effective_usage": "legacy_used_count_plus_deduplicated_runtime_heat"
  },
  "write": {
    "default_update_mode": "auto",
    "promotion_threshold": 10,
    "demotion_days": 30
  },
  "smart_routing": {
    "enabled": true,
    "project_keywords": {
      "example": {
        "keywords": ["example", "demo"],
        "weight": 1.0
      }
    },
    "confidence_threshold": 2,
    "fallback_to_recent": true,
    "kb_history_lookup": true,
    "code_feature_scan": false,
    "auto_learn_from_kb": true
  }
}
